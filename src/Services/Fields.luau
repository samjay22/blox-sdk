--- Lazily iterate cursor pages, preserving filters and surfacing errors.
function Service.snapshotPages(
	self: Service,
	req: Types.SnapshotCall,
	opts: Core.CallOptions?,
	maximum: number?
): () -> Core.Result<Types.SnapshotResultValue>?
	local request: Types.SnapshotCall = Idempotency.copy(req or {})
	local query = table.clone(request.query or {})
	request.query = query
	return Pagination.cursor(function(cursor: string?): Core.Result<Types.SnapshotResultValue>
		query.cursor = cursor
		return self.snapshot(self, request, opts)
	end, function(page: Types.SnapshotResultValue): (string | Core.Null)?
		return page.nextCursor
	end, maximum, query.cursor)
end
