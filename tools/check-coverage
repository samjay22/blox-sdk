#!/usr/bin/env python3
"""Assert exact route coverage, uniqueness, schema integrity and additive auth routes."""
from __future__ import annotations
import json
import re
from service_contracts import SOURCES, SOURCE_ROOT
from collections import Counter
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
SOURCES = dict(SOURCES)
SOURCES['config'] = SOURCE_ROOT / 'svc' / 'config-service'
ALIASES={'mm':'matchmaking','code':'codes'}
# Independent deployment contract: do not import the generator's routing declarations.
GATEWAY='https://lb1.blox-api.com'
PREFIXES={
    'auth':'/auth-service', 'matchmaking':'/matchmaking-service',
    'party':'/party-service', 'codes':'/code-service', 'audit':'/audit-service',
    'leaderboards':'/leaderboard-service',
    'fields':'/fields-service', 'platform':'/platform-service',
    'config':'/remote-config-service',
}
# Documented Boot routes have no annotated controller; keep them independently required.
# CodeService is a hand-written facade; its methods are named for the task, not the controller.
HANDWRITTEN={'codes.redeem':'redeem','codes.createCode':'create','codes.bulkCreateCodes':'createBatch','codes.exportBatch':'exportBatch',
    'codes.searchCodes':'list','codes.getCode':'get','codes.updateCode':'update','codes.deleteCode':'delete','codes.listRedemptions':'redemptions'}
# ConfigService is hand-written too: its admin calls live on the namespace handle (src/Configs/Namespace.luau).
CONFIG_METHODS={'config.namespaces':'Service.namespaces','config.namespace':'Namespace.info','config.snapshot':'Namespace.refresh',
    'config.entries':'Namespace.entries','config.entry':'Namespace.entry','config.putEntry':'Namespace.set','config.deleteEntry':'Namespace.delete',
    'config.changeEntries':'Namespace.setMany','config.history':'Namespace.history','config.version':'Namespace.at','config.rollback':'Namespace.rollback'}
BOOT_SERVICES = {'audit', 'leaderboards', 'fields', 'platform', 'codes'}

# Exact contract additions may land before parallel backend controller implementations.
SCALE_ROUTES = {('fields', 'POST', '/api/fields/universes/{universeId}/' + path)
                for path in ('sessions/acquire', 'sessions/renew', 'sessions/release', 'sessions/poll', 'commits')}


def assert_gateway_coverage(endpoints: list[dict], routing: str) -> None:
    """Verify every generated gateway target independently, rejecting retired service targets."""
    gateway = re.search(r'gatewayUrl\s*=\s*"([^"]+)"', routing)
    prefixes = dict(re.findall(r'\["([^"]+)"\]\s*=\s*"([^"]+)"', routing))
    assert gateway and gateway[1] == GATEWAY, 'Incorrect default gateway'
    assert prefixes == PREFIXES, 'Incorrect or missing gateway service prefix'
    assert {e['service'] for e in endpoints} == set(PREFIXES), 'Unrouted service'
    wire_routes = set()
    for e in endpoints:
        path = e['path']
        assert path.startswith('/') and not path.startswith('//'), 'Expected backend-relative path'
        assert not any(path.startswith(p+'/') or path == p for p in PREFIXES.values()), 'Prefix applied twice'
        wire_routes.add((e['method'], GATEWAY+prefixes[e['service']]+path))
    assert len(wire_routes) == len(endpoints), 'Duplicate gateway routes'

def mapping_arguments(text: str, start: int) -> str:
    """Read mapping arguments independently; quoted regex/path parentheses are not delimiters."""
    while start < len(text) and text[start].isspace(): start += 1
    if start >= len(text) or text[start] != '(': return ''
    depth, quoted, escaped = 1, False, False
    for i in range(start+1, len(text)):
        c = text[i]
        if quoted:
            if escaped: escaped = False
            elif c == chr(92): escaped = True
            elif c == '"': quoted = False
        elif c == '"': quoted = True
        elif c == '(': depth += 1
        elif c == ')':
            depth -= 1
            if depth == 0: return text[start+1:i].strip()
    raise AssertionError('Unbalanced controller mapping')


def mapping_paths(args: str) -> list[str]:
    """Expand literal route arrays independently and reject constants or mixed expressions."""
    if not args: return ['']
    named = re.search(r'(?:^|,)\s*(?:value|path)\s*=\s*(.*)', args)
    candidate = named[1] if named else args
    if candidate.startswith('{'):
        match = re.match(r'\{\s*("[^"\n]*"(?:\s*,\s*"[^"\n]*")*)\s*\}(?:\s*,|\s*$)', candidate)
        assert match, f'Unsupported mapping path syntax: {args}'
        return re.findall(r'"([^"\n]*)"', match[1])
    match = re.match(r'"([^"\n]*)"(?:\s*,|\s*$)', candidate)
    assert match, f'Unsupported mapping path syntax: {args}'
    return [match[1]]


def controller_routes() -> set[tuple[str,str,str]]:
    """Independently scan all annotated source classes, regardless of their filenames."""
    found = set()
    for service, root in SOURCES.items():
        files = sorted(root.glob('src/main/java/**/*.java'))
        controllers = 0
        for file in files:
            text = file.read_text()
            # Strip comments but preserve strings (including URLs containing //).
            text = re.sub(r'"(?:\\.|[^"\\])*"|/\*.*?\*/|//[^\n]*',
                          lambda m: m[0] if m[0].startswith('"') else '', text, flags=re.S)
            if not re.search(r'@(RestController|Controller)\b', text): continue
            controllers += 1
            head, body = text.split('class ', 1)
            base = re.search(r'@RequestMapping\b', head)
            prefixes = mapping_paths(mapping_arguments(head,base.end())) if base else ['']
            for match in re.finditer(r'@(Get|Post|Put|Patch|Delete|Request)Mapping\b', body):
                method, args = match[1].upper(), mapping_arguments(body, match.end())
                if method == 'REQUEST':
                    verbs = re.findall(r'RequestMethod\.(\w+)', args)
                    assert len(verbs)==1, f'Unsupported mapping methods in {file}'
                    method = verbs[0]
                for prefix in prefixes:
                    for suffix in mapping_paths(args):
                        path = (prefix+suffix).replace("{u}", "{universeId}")
                        if service == "platform" and path.startswith("/platform-service/"): path = path[len("/platform-service"): ]
                        paths = [path]
                        for token, options in re.findall(r"\{(\w+):([^{}]+)\}", path):
                            paths = [p.replace("{"+token+":"+options+"}", choice) for p in paths for choice in options.split("|")]
                        for expanded in paths: found.add((service, method, expanded))
        assert controllers, f'Missing backend controller sources: {root}'
    return found


def assert_controller_coverage(actual: set[tuple[str,str,str]]) -> None:
    """Fail if even a route absent from the checked-in inventory is absent from the SDK."""
    framework = {(service, 'GET', '/'+name) for service in BOOT_SERVICES for name in ('metrics','info')}
    internal = {('fields', 'POST', '/api/fields/internal/batch'), ('leaderboards', 'POST', '/internal/batch')}
    # The checked-in fields-service tree predates the move of game values to config-service; these routes are gone.
    retired = {('fields', 'GET', '/api/fields/universes/{universeId}/game-values/{fieldPath}/history'),
               ('fields', 'POST', '/api/fields/universes/{universeId}/game-values/{fieldPath}/rollback')}
    missing = (controller_routes() - retired | framework) - actual - internal
    assert not missing, f'Missing controller routes: {sorted(missing)}'
    # Only documented framework endpoints and the explicitly unverified Party snapshot
    # may exist without a controller; stale speculative domain APIs must fail too.
    extra = {r for r in actual - controller_routes() - SCALE_ROUTES
             if r[0] != 'party' and (r[1], r[2]) not in {('GET','/metrics'),('GET','/info')}}
    assert not extra, f'Removed or fabricated routes: {sorted(extra)}'


def main() -> None:
    """Fail closed when a route, controller schema or expected alias is missing."""
    routes=json.loads((ROOT/'routes.json').read_text())
    endpoints=json.loads((ROOT/'spec/endpoints.json').read_text())['endpoints']
    modules={p.stem.lower() for p in (ROOT/'src/Services').glob('*.luau')}
    assert modules == set(PREFIXES), 'Unexpected or missing service modules'
    assert_gateway_coverage(endpoints, (ROOT/'src/Core/Routing.luau').read_text())
    expected={(ALIASES.get(r['svc'],r['svc']),r['method'],r['path']) for r in routes}
    actual={(e['service'],e['method'],e['path']) for e in endpoints}
    assert len(expected)==len(routes),'Duplicate inventory routes'
    assert_controller_coverage(actual)
    assert len(actual)==len(endpoints),'Duplicate endpoint mappings'
    assert len({e['id'] for e in endpoints})==len(endpoints),'Duplicate SDK method IDs'
    assert expected == actual, f'Inventory mismatch: {sorted(expected ^ actual)}'
    required={('auth','DELETE',p) for p in ['/api/auth/universes/{universeId}/places/{placeId}']}
    required|={('auth',m,'/api/auth/service-accounts'+p) for m,p in [('POST',''),('GET',''),('GET','/{id}'),('PUT','/{id}/permissions'),('PATCH','/{id}'),('DELETE','/{id}')]}
    required.add(('auth','POST','/api/auth/orgs/{org}/service-accounts/{id}/rotate'))
    assert required<=actual,'Missing additive DELETE/service-account routes'
    for e in endpoints:
        assert e['source'] and e['responseJava'] and e['responseType'],e['id']
        assert e['minimumLevel'] in (None,'READ','READ_WRITE','ADMIN'),e['id']
        assert not e['cacheable'] or e['method']=='GET',e['id']
        module=(ROOT/'src/Services'/f'{e["service"].capitalize()}.luau').read_text()
        if e['service']=='config': module+=(ROOT/'src/Configs/Namespace.luau').read_text()
        method=HANDWRITTEN.get(e['id'],e['name'])
        qualified=CONFIG_METHODS.get(e['id'],'Service.'+method)
        assert 'function '+qualified+'(' in module,e['id']
        assert f'--- {e["method"]} {PREFIXES[e["service"]]}{e["path"]} via gateway;' in module,e['id']
        assert f'Endpoints["{e["id"]}"]' in module + ((ROOT/'src/Fields/Client.luau').read_text() if e['id']=='fields.validateOps' else ''),e['id']
    counts=Counter(x[0] for x in expected)
    totals=Counter(e['service'] for e in endpoints)
    for service in sorted(counts): print(f'{service}: {counts[service]}/{counts[service]} inventory routes (100%); {totals[service]} exposed')
    print(f'Controllers: {len(controller_routes())}/{len(controller_routes())} new-service routes (100%)')
    print(f'Total: {len(expected)}/{len(expected)} inventory + {len(actual-expected)} additive = {len(actual)} endpoints')
    print(f'Gateway: {GATEWAY}; all {len(PREFIXES)} prefixes / {len(actual)} wire routes verified')
if __name__=='__main__':main()
