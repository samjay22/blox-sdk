#!/usr/bin/env python3
"""Generate the public API reference directly from strict Luau sources, offline."""
from __future__ import annotations

import argparse
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HELPERS = ('Profile', 'Transaction', 'Schema', 'OpBuilder', 'Bulk', 'Schedules', 'Jobs', 'Health', 'Rotations', 'Generators')


def declarations(source: str) -> list[tuple[str, str, str]]:
    """Extract documented public signatures without copying implementation bodies."""
    result = []
    pattern = r'(?P<doc>(?:^---[^\n]*\n)+)function (?P<name>\w+\.\w+)(?:<[^\n]+?>)?(?P<sig>\([^\n]*(?:\n[\s\S]*?)?)'
    for match in re.finditer(pattern, source, re.M):
        start = match.start('sig')
        depth, end = 0, start
        for end in range(start, len(source)):
            char = source[end]
            if char == '(':
                depth += 1
            elif char == ')':
                depth -= 1
                if depth == 0:
                    break
        end = source.find('\n', end)
        signature = source[match.start('name'):end].strip()
        doc = '\n'.join(line.removeprefix('---').strip() for line in match['doc'].splitlines())
        result.append((match['name'], signature, doc))
    return result


def type_exports(source: str) -> list[str]:
    """Collect complete type aliases; opaque implementation handles expose only their alias names."""
    result = []
    for match in re.finditer(r'^export type (\w+(?:<[^\n]+?>)?)\s*=', source, re.M):
        start = match.start()
        tail = source[start:]
        boundary = re.search(r'\n(?=export type |local |function |---|return )', tail)
        block = tail[:boundary.start() if boundary else len(tail)].strip()
        if 'typeof(setmetatable' in block:
            block = f'export type {match[1]} = -- opaque handle; see methods below'
        result.append(block)
    return result


def render(paths: list[Path], root: Path) -> str:
    """Render stable source links, docstrings, signatures and all exported contract aliases."""
    lines = ['<!-- Generated by tools/gen-docs; do not edit. -->', '# API reference', '',
             'All SDK methods use lowerCamelCase. Native Roblox APIs keep engine casing.', '',
             'Types are available from the named source/Roblox module; `Types/*` is the public wire-contract namespace.',
             'Underscore members and module constructors other than `BloxSDK.new` are private implementation details.', '']
    for path in paths:
        source = path.read_text()
        relative = path.relative_to(root)
        lines += [f'## {path.stem}', '', f'Source: [{relative}](../../{relative})', '']
        if path.stem == 'BloxSDK':
            lines += ['### Root values and utility functions', '', '```luau']
            lines += re.findall(r'^SDK\.\w+ = [^\n]+', source, re.M)
            lines += ['```', '', 'No internal module tables are exported. Utility signatures below are resolved from their source definitions.', '']
            imports = dict(re.findall(r'local (\w+) = require\("(\.[^"\n]+)"\)', source))
            for alias, module, method in re.findall(r'^SDK\.(\w+) = (\w+)\.(\w+)\s*$', source, re.M):
                if module not in imports:
                    continue
                origin = (path.parent/imports[module]).with_suffix('.luau')
                for name, signature, doc in declarations(origin.read_text()):
                    if name.endswith('.' + method):
                        lines += [f'### `SDK.{alias}`', '', doc, '', '```luau',
                                  signature.replace(name, f'SDK.{alias}', 1), '```', '',
                                  f'Definition: [{origin.relative_to(root)}](../../{origin.relative_to(root)}).', '']
                        break
        for name, signature, doc in declarations(source):
            if name.endswith('.new') and path.stem != 'BloxSDK':
                continue
            lines += [f'### `{name}`', '', doc, '', '```luau', signature, '```', '']
        types = type_exports(source)
        if types:
            lines += ['### Exported types', '', '```luau', '\n\n'.join(types), '```', '']
    return '\n'.join(lines)


def outputs(root: Path = ROOT) -> dict[Path, str]:
    """Map each stable public reference page to its deterministic source-derived content."""
    pages = {'client': [root/'src/BloxSDK.luau', root/'src/Core/Config.luau', root/'src/Types/Core.luau', root/'src/Core/ChangeSignal.luau'],
             'helpers': [root/f'src/Fields/{name}.luau' for name in HELPERS] +
                        [root/'src/Fields/Types.luau', root/'src/Core/SnapshotCache.luau', root/'src/Core/AuditWriter.luau']}
    for path in sorted((root/'src/Services').glob('*.luau')):
        pages[path.stem.lower()] = [path, root/'src/Types'/path.name]
    result = {root/f'docs/api/{name}.md': render(paths, root) for name, paths in pages.items()}
    index = ['<!-- Generated by tools/gen-docs; do not edit. -->', '# BloxSDK 5.0.0 API', '']
    index += [f'- [{name.title()}]({name}.md)' for name in pages]
    result[root/'docs/api/README.md'] = '\n'.join(index) + '\n'
    errors = (root/'src/Core/Errors.luau').read_text()
    codes = set(re.findall(r'^\s*([A-Za-z_]\w*) = true,', errors, re.M))
    for path in (root/'src').rglob('*.luau'):
        codes.update(re.findall(r'(?:failure|fail)\("([a-z][a-z0-9_]*)"', path.read_text()))
    kinds = re.findall(r'"(\w+)"', (root/'src/Types/Core.luau').read_text().split('export type ErrorKind =', 1)[1].split('export type OperationDiagnostic', 1)[0])
    reference = ['<!-- Generated by tools/gen-docs; do not edit. -->', '# Error code reference', '',
                 'Every failure is `{ok=false,error=BloxError}` with required kind, code, message, endpoint and attempts.',
                 'HTTP status is optional. Bodies are redacted; messages are not a parsing contract.',
                 'Switch on kind for cross-service behavior; code identifies a specific diagnostic.', '',
                 '## SDK fallback codes', '', '| Code | Kind |', '|---|---|']
    reference += [f'| `sdk_{re.sub(r"([a-z])([A-Z])", r"\1_\2", kind).lower()}` | `{kind}` |' for kind in kinds]
    reference += ['', 'Local queue saturation is RateLimited / sdk_rate_limited with no HTTP status. Budget waits may instead',
                  'reach Timeout. Retry only eligible keyed/idempotent operations within the original deadline.',
                  'Unauthorized/Forbidden need credential/grant correction; Validation needs input correction; Conflict',
                  'needs authoritative reload/reconciliation, not a fresh key that duplicates an uncertain write.', '',
                  '## Domain codes', '',
                  'The following allowlisted backend and local validation codes are collected from source.',
                  'Recognized codes are normalized to lowercase snake_case across all services (including Auth).',
                  'Backend error text and unknown backend codes are never copied; unknown codes use the SDK fallback.',
                  'Diagnostic path/field/opIndex are bounded; service HTTP rules and the backend remain authoritative.', '',
                  '| Code |', '|---|']
    reference += [f'| `{code}` |' for code in sorted({code.lower() for code in codes})]
    reference += ['', 'See [fault tolerance](FAULT-TOLERANCE.md), [authentication](AUTH.md), [Fields](FIELDS.md),',
                  '[rotations](ROTATIONS.md), and [matchmaking](MATCHMAKING.md) for service-specific recovery.', '']
    result[root/'docs/ERRORS.md'] = '\n'.join(reference)
    return result


def synchronize(generated: dict[Path, str], directory: Path, check: bool) -> list[Path]:
    """Detect missing, stale and extra pages; check mode never changes files."""
    drift = []
    for path, text in generated.items():
        if check:
            if not path.is_file() or path.read_text() != text:
                drift.append(path)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
    drift.extend(sorted(set(directory.glob('*.md')) - set(generated)))
    return drift


def main() -> None:
    """Write references or fail verification when checked-in documentation has drifted."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    generated = outputs()
    drift = synchronize(generated, ROOT/'docs/api', args.check)
    if drift:
        raise SystemExit('API documentation drift: ' + ', '.join(str(p.relative_to(ROOT)) for p in drift))
    print(f'{"Verified" if args.check else "Generated"} {len(generated)} API reference pages')


if __name__ == '__main__':
    main()
