#!/bin/sh
# All local checks are offline; no package installers or artifact publishing.
set -eu
cd "$(dirname "$0")/.."
export PATH="/opt/homebrew/bin:$HOME/.aftman/bin:$PATH"
python3 tools/gen-vectors.py --check
python3 tools/check-field-vectors.py
stylua --check src tests examples roblox
# Installed Luau 0.703 can SIGTRAP in parallel type checking; serialize without skipping checks.
luau-analyze -j1 src tests examples
selene src tests examples
luau tests/run.luau
lune run tests/run.luau
python3 tools/gen.py --check
python3 tools/build-roblox.py --check
python3 tools/check-coverage
python3 tools/verify-package.py
rojo build default.project.json -o /private/tmp/BloxSDK.rbxm
python3 -m unittest discover -s tests -p 'test_*.py'
python3 tools/check-package
